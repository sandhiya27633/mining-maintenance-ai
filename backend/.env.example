# backend/.env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Supabase ───────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — copy from: Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Database (direct connection — optional, for admin tasks) ───────
# Get from: Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ── Application ────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=2.0.0
APP_TITLE=Mining Maintenance AI

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Demo seed ──────────────────────────────────────────────────────
DEMO_VEHICLES_COUNT=10
DEMO_SIMULATION_DAYS=90
DEMO_RANDOM_SEED=42
